{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Article JSON sections (writer output contract)",
  "type": "object",
  "required": ["title", "slug", "description", "targetKeyword", "audience", "sections"],
  "properties": {
    "title": { "type": "string", "minLength": 10, "maxLength": 60 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "maxLength": 160 },
    "targetKeyword": { "type": "string" },
    "audience": { "enum": ["business", "developer", "general"] },
    "internalLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["heading", "body"],
        "properties": {
          "heading": { "type": "string", "minLength": 3 },
          "body": { "type": "string", "minLength": 80 },
          "type": { "enum": ["paragraph", "list", "faq", "quote"] }
        }
      }
    }
  }
}
